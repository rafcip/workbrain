{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-opentext.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-bash-writes.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/run-tests.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(//home/ubuntu/workbrain/**)",
      "Read(//srv/workbrain/**)",
      "Read(//etc/**)",

      "Bash(git:*)",
      "Bash(gh:*)",

      "Bash(systemctl:*)",
      "Bash(journalctl:*)",
      "Bash(loginctl:*)",
      "Bash(service:*)",

      "Bash(apt-get:*)",
      "Bash(apt:*)",
      "Bash(apt-cache:*)",
      "Bash(dpkg:*)",

      "Bash(ufw:*)",
      "Bash(fail2ban-client:*)",
      "Bash(sshd:*)",
      "Bash(ssh-keygen:*)",
      "Bash(ssh-keyscan:*)",

      "Bash(docker:*)",
      "Bash(restic:*)",
      "Bash(plaud:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",

      "Bash(sudo -u ubuntu:*)",
      "Bash(chown:*)",
      "Bash(chmod:*)",
      "Bash(install:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ln:*)",
      "Bash(tee:*)",
      "Bash(sed:*)",
      "Bash(swapon:*)",
      "Bash(swapoff:*)",
      "Bash(mkswap:*)",
      "Bash(fallocate:*)",
      "Bash(sysctl:*)",
      "Bash(findmnt:*)",

      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(free:*)",
      "Bash(ss:*)",
      "Bash(ps:*)",
      "Bash(who:*)",
      "Bash(id:*)",
      "Bash(passwd -S:*)",
      "Bash(tmux:*)",
      "Bash(curl:*)"
    ],
    "deny": [
      "Read(//srv/workbrain/env.prod)",
      "Read(//srv/workbrain/restic-pass)",
      "Read(//srv/workbrain/deploy-key-github)",
      "Read(//home/ubuntu/.plaud/**)",
      "Read(//home/ubuntu/.ssh/id_*)",
      "Read(//root/.ssh/id_*)",
      "Read(//etc/ssh/*_key)",
      "Read(//etc/shadow)",

      "Bash(rm -rf /:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Bash(chmod -R 777:*)"
    ]
  }
}
